[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name | replace('\\', '\\\\') | replace('"', '\\"') }}"
requires-python = ">=3.14"
dependencies = [
    "django>=6.1.3,<6.2",          # the web framework
    "psycopg[binary]>=3.3",        # PostgreSQL driver
    "django-environ>=0.14",        # reads settings from environment variables and .env
    "gunicorn>=26",                # production web server
    "whitenoise>=6.12",            # serves static files (the admin's CSS/JS) in production
    "redis>=8.1",                  # Redis client for Django's built-in Redis cache
    "argon2-cffi>=25.1",           # Argon2 password hashing (see PASSWORD_HASHERS)
    "django-axes>=9.0",            # login rate limiting (locks out repeated failed logins)
    "django-storages[s3]>=1.14.6", # uploaded files in S3, if DJANGO_MEDIA_STORAGE=s3
    "django-tasks-db==0.13.0",     # background jobs in production (exact: pre-1.0, so
                                   # an update could change its tables or worker)
]

[dependency-groups]
# Installed by `uv sync` on your machine, never in the production image.
dev = [
    "pytest>=9",
    "pytest-django>=4.14",
    "pytest-env>=1.8.5",
    "ruff>=0.17",
    "pytest-cov>=7.1",             # test coverage: uv run pytest --cov
    "pre-commit>=4.7",             # runs gitleaks and ruff on every commit
    "pip-audit>=2.10",             # checks the locked packages for known vulnerabilities
]

[tool.uv]
package = false                    # an application, not a library to publish

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings"
# Tests always run as the test environment (set before Django loads settings).
env = ["DJANGO_ENV=test"]
addopts = "--strict-markers"
python_files = ["tests.py", "test_*.py"]   # Django-style tests.py plus tests/test_*.py
# Fail on every Django deprecation warning, wherever it's raised, so upgrades never
# surprise you: features removed in the next version and in the one after it. (Django's
# version-numbered class names change with each release; these two names stay the same
# and always mean the current ones.) Tests that run manage.py in their own process set
# the same two rules there (tests/test_production_settings.py), and
# tests/test_deprecation_warnings.py checks both. Other libraries' deprecations don't
# fail the tests: you can't fix their code.
filterwarnings = [
    "error::django.utils.deprecation.RemovedInNextVersionWarning",
    "error::django.utils.deprecation.RemovedAfterNextVersionWarning",
]

[tool.ruff]
line-length = 100
target-version = "py314"
extend-exclude = ["*/migrations/*"]

[tool.ruff.lint]
# E/W/F: errors and style, I: import order, B: likely bugs, S: security,
# DJ: Django-specific rules, UP: modern Python syntax
select = ["E", "W", "F", "I", "B", "S", "DJ", "UP"]

[tool.ruff.lint.per-file-ignores]
# Tests may use assert, dummy passwords and subprocess.
"**/tests*.py" = ["S101", "S105", "S106", "S603"]
"tests/*.py" = ["S101", "S105", "S106", "S603"]

# Test coverage, measured with `uv run pytest --cov` (pytest-cov).
[tool.coverage.run]
source = ["."]
branch = true                      # also checks both sides of every if/else
patch = ["subprocess"]             # also measures the Django processes some tests start
omit = [
    ".venv/*",
    "*/migrations/*",
    "*/tests.py",
    "*/tests/*",
    "config/settings.py",          # only exists for a moment, in a settings-package test
]

[tool.coverage.report]
show_missing = true                # lists the lines the tests never run
skip_covered = true                # leaves fully covered files out of the list
fail_under = 80                    # `pytest --cov` fails below 80% total coverage
