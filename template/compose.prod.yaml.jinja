# Production: Postgres, Redis, the migrate step, the app, the background-job worker and
# Caddy, the reverse proxy in front of them. Run it with
#   docker compose -f compose.yaml -f compose.prod.yaml up --build -d --wait
# Settings and secrets come from four files next to this one, never from this file or
# the image (git and .dockerignore both ignore them; see the README for each):
#   .env.production  Django's settings, including DATABASE_URL and CACHE_URL
#   .env.postgres    the database login: user, password and database name
#   .env.redis       the Redis password (REDIS_PASSWORD)
#   .env.caddy       the site's domain (SITE_ADDRESS), for its HTTPS certificate

# Its own project name, so production's containers and database volume are separate
# from development's even on the same machine.
name: {{ project_slug }}-production

# Every service's logs: rotated at 10 MB, at most 5 files per container, full ones
# compressed. Docker's default keeps them without any limit, so a busy or attacked site
# (every request adds a line) could fill the disk and stop the database. json-file is
# Docker's standard format, which every log-shipping tool can read. To use another
# driver (journald, syslog, ...), replace this whole block: those reject these options.
x-logging: &logging
  driver: json-file
  options:
    max-size: 10m
    max-file: "5"
    compress: "true"

# The app image, as the migrate step, the app and the worker run it. Locked down: no Linux
# capabilities, no way to gain privileges, and a read-only filesystem apart from /tmp
# and the two uploads volumes.
x-app: &app
  build: .
  image: {{ project_slug }}-web
  env_file: .env.production
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  read_only: true
  # /tmp is in memory: capped, so large uploads (Django keeps one being received there)
  # can't use up the server's memory. Caddy refuses requests over 10 MB anyway.
  tmpfs: ["/tmp:size=64m"]
  networks: [backend]
  logging: *logging

services:
  db:
    env_file: .env.postgres
    logging: *logging
    security_opt: ["no-new-privileges:true"]
    # No published port and only the internal network: the app reaches it, nothing else.
    # (Its entrypoint starts as root to set up the data folder, so no cap_drop here.)
    networks: [backend]
    volumes:
      - pgdata:/var/lib/postgresql
    restart: unless-stopped

  # The cache, locked down like the app: it runs as its own unprivileged user with a
  # login, saves nothing to disk, and only the internal network reaches it. /data is in
  # memory: it only holds the login file Redis writes at start.
  redis:
    env_file: .env.redis
    logging: *logging
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    read_only: true
    tmpfs: ["/data:uid=999,gid=999,mode=0700"]   # 999 is the redis user in the image
    networks: [backend]
    restart: unless-stopped

  # Applies migrations, then exits. The app starts only if it succeeded, so new code
  # never runs against an old database. On a redeploy the old app keeps serving while
  # this runs, so migrations must also work with the old code (see the README).
  migrate:
    <<: *app
    command: ["python", "manage.py", "migrate", "--noinput"]
    healthcheck:
      disable: true                    # it never serves /healthz
    depends_on:
      db:
        condition: service_healthy

  web:
    <<: *app
    depends_on:
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
    # backend reaches the database and Redis; default is where Caddy reaches the app, and
    # lets it reach the internet (a mail server, S3). No published port: only Caddy
    # faces the internet.
    networks: [backend, default]
    # Not secrets, so written here. Always behind Caddy, which sets X-Forwarded-Proto and
    # X-Forwarded-For (DJANGO_BEHIND_PROXY in .env.example), and sends private uploads
    # once the app has checked who's asking (DJANGO_MEDIA_SENT_BY_PROXY,
    # config/uploads.py).
    environment:
      DJANGO_BEHIND_PROXY: "true"
      DJANGO_MEDIA_SENT_BY_PROXY: "true"
    volumes:
      - media:/app/media               # private uploads (the rest of the app is read-only)
      - media_public:/app/media-public # public uploads
    restart: unless-stopped
    # Longer than Gunicorn's graceful_timeout (30 s), so requests in progress finish
    # before Docker force-stops the container.
    stop_grace_period: 35s

  # Runs background jobs: those the app enqueued, stored in the database. Same image,
  # settings and lockdown as the app, but it serves nothing, so no port, and its own
  # health check instead of the web one. Starts only once migrate succeeded, like the app.
  worker:
    <<: *app
    command: ["python", "manage.py", "db_worker"]
    # Unhealthy when the database doesn't answer, or jobs have waited over 5 minutes with
    # none started (the worker is stuck or stopped): see config/health.py. It serves no
    # /healthz, so this replaces the image's check.
    healthcheck:
      test: ["CMD", "python", "-m", "config.health", "worker"]
      interval: 60s
      timeout: 20s
      start_period: 30s
    depends_on:
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
    # default lets jobs reach the internet (a mail server, S3), like the app.
    networks: [backend, default]
    volumes:
      - media:/app/media               # the same uploaded files the app sees
      - media_public:/app/media-public
    restart: unless-stopped
    # On stop, the worker finishes the job in progress, then exits. A job still running
    # after this is killed and stays marked as running, so keep each job well under 60s.
    stop_grace_period: 60s

  # The reverse proxy: HTTPS (it gets and renews the certificate itself), rate limits,
  # uploaded files, and the site's own page when the app doesn't answer. See
  # deploy/Caddyfile. The only service the internet reaches. Built from
  # deploy/caddy.Dockerfile (Caddy with the rate-limit plugin). Locked down like the app:
  # its own unprivileged user, no Linux capabilities, no way to gain privileges, a
  # read-only filesystem apart from its volumes.
  caddy:
    build:
      context: ./deploy
      dockerfile: caddy.Dockerfile
    image: {{ project_slug }}-caddy
    env_file: .env.caddy
    logging: *logging
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    read_only: true
    tmpfs: [/tmp]
    # Lets its unprivileged user listen on ports 80 and 443 inside its own network
    # namespace, without a capability. (Docker's default since 20.10; set here so it
    # doesn't depend on that.)
    sysctls:
      net.ipv4.ip_unprivileged_port_start: 0
    # Started once the app has started, not waiting for it to be healthy: if the app
    # can't start, visitors still get the error page instead of no answer at all.
    depends_on:
      web:
        condition: service_started
    healthcheck:
      # Caddy's admin API answers only inside the container (127.0.0.1: "localhost" would
      # try IPv6 first, where it doesn't listen).
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 5s
      start_period: 10s
    ports:
      - "80:80"                        # plain HTTP: redirects to HTTPS, and certificate checks
      - "443:443"                      # HTTPS
      - "443:443/udp"                  # HTTPS over HTTP/3
    volumes:
      # Folders, not single files: a single file stays the old copy in a running
      # container after git or copier replaces it.
      - ./deploy:/etc/caddy:ro         # the Caddyfile
      - ./templates:/srv/errors:ro     # proxy_error.html (the only file it serves from here)
      # Uploads, to serve them: public ones to anyone, private ones only when the app
      # has checked who's asking (X-Accel-Redirect).
      - media:/srv/media:ro
      - media_public:/srv/media-public:ro
      - caddy_data:/data               # certificates and keys: keep, or Caddy asks again
      - caddy_config:/config
    restart: unless-stopped

networks:
  # Where Caddy is published. IPv6 on, so Docker passes IPv6 visitors' own addresses to
  # Caddy: without it, Docker relays their connections itself and every IPv6 visitor
  # arrives from one address, sharing one rate limit. (Docker Engine 27 or later picks
  # the IPv6 range itself.)
  default:
    enable_ipv6: true
  backend:
    internal: true                     # no internet access from the database or Redis

volumes:
  pgdata:
  media:
  media_public:
  caddy_data:
  caddy_config:
