# What every environment shares. Docker Compose combines it with another file:
#   Development: `docker compose up -d` also loads compose.override.yaml by itself.
#   Production:  `docker compose -f compose.yaml -f compose.prod.yaml ...` loads
#                compose.prod.yaml instead (the dev override is left out).
name: {{ project_slug }}

services:
  db:
    # Official Postgres 18 on Debian trixie. Extensions such as pgvector are added per
    # project when one needs them.
    image: postgres:18-trixie
    healthcheck:
      # Over TCP (-h), the way the app connects: on a new database Postgres first runs
      # a setup server that only answers locally. $$ passes the variables to the
      # container's shell instead of Compose.
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      start_period: 60s              # time to start, or to recover after a crash
      start_interval: 2s             # checked often while starting, so `up` is quick
      interval: 10s
      retries: 5

  # Django's cache. Cache only: nothing is saved to disk, and when it's full the least
  # recently used keys are dropped, so it never grows past its memory limit (raise
  # --maxmemory here if a project needs more).
  #
  # It needs a login, because Django unpickles what it reads back: anything that could
  # write to an open Redis could run code in the app. Users, from REDIS_PASSWORD:
  #   app          Django's login (CACHE_URL), without Redis's admin commands
  #   healthcheck  no password, and allowed only PING
  #   default      the no-login user, switched off
  # The password goes into a file Redis reads at start, so it never shows in the
  # process list.
  redis:
    image: redis:8-trixie            # official Redis 8 on Debian trixie
    user: redis                      # never root, so the image skips its root setup
    command:
      - sh
      - -c
      - |
        : "$${REDIS_PASSWORD:?REDIS_PASSWORD must be set}"
        umask 077
        printf '%s\n' \
          'user default off' \
          "user app on >$${REDIS_PASSWORD} ~* &* +@all -@dangerous +flushdb" \
          'user healthcheck on nopass -@all +ping' > /data/users.acl
        exec redis-server --aclfile /data/users.acl --save "" --appendonly no \
          --maxmemory 256mb --maxmemory-policy allkeys-lru
    healthcheck:
      test: ["CMD", "redis-cli", "--no-auth-warning", "--user", "healthcheck", "--pass", "x", "ping"]
      start_period: 30s
      start_interval: 2s
      interval: 10s
      retries: 5
