# What every environment shares. Docker Compose combines it with another file:
#   Development: `docker compose up -d db` also loads compose.override.yaml by itself.
#   Production:  `docker compose -f compose.yaml -f compose.prod.yaml ...` loads
#                compose.prod.yaml instead (the dev override is left out).
name: {{ project_slug }}

services:
  db:
    image: postgres:18-trixie        # official Postgres 18 on Debian trixie
    healthcheck:
      # $$ passes the variables to the container's shell instead of Compose.
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      interval: 2s
      retries: 20
