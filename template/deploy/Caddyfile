# The reverse proxy in front of the app: compose.prod.yaml's caddy service. It gets and
# renews HTTPS certificates for SITE_ADDRESS (from .env.caddy) by itself, and redirects
# plain HTTP to HTTPS. After changing this file, restart Caddy (see the README).
{
	# Caddy's admin API, which can change this configuration, answers only inside the
	# container (its health check uses it).
	admin 127.0.0.1:2019
	# Not one log line per health check (the admin API logs each request it gets).
	log default {
		exclude admin.api
	}
}

# The basic security headers on what Caddy serves itself (uploads, the error page). "?"
# adds each only when the app hasn't set it already. HSTS is left to the app's own
# setting (DJANGO_SECURE_HSTS_SECONDS), so there's one place to change it. No "Server" or
# "Via" header naming Caddy.
(security_headers) {
	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy same-origin
		-Server
		-Via
	}
}

# What every upload is sent with: always a download, never shown as a page, so an
# uploaded HTML or SVG file can't run scripts on this site. config/uploads.py's
# DOWNLOAD_HEADERS does the same when Django sends a file: keep both alike.
(download_headers) {
	header {
		Content-Disposition attachment
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; sandbox"
	}
}

# How Caddy talks to the app. Caddy takes in the first 1 MB of each request before
# passing it on (bigger ones pass on as they arrive; request_body caps them), and up to
# 1 MB of each response at once, so a slow visitor ties up Caddy, which handles many at a
# time, instead of one of Gunicorn's few workers. While the app restarts (a deploy), it
# keeps trying for a few seconds before showing the error page.
(app_proxy) {
	request_buffers 1MB
	response_buffers 1MB
	lb_try_duration 10s
	lb_try_interval 250ms
}

{$SITE_ADDRESS} {
	import security_headers

	# One line per request Caddy answers itself (uploads, hidden health checks, the error
	# page), as JSON on stdout like the app's logs, without query strings (they can hold
	# tokens). Requests the app answers are skipped below: the app logs those.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>headers delete
				resp_headers delete
			}
		}
	}

	# The largest request accepted: bigger ones get 413 before reaching the app. Raise it
	# if the project takes bigger uploads (Django keeps an upload being received in the
	# app's /tmp, in memory: raise its size in compose.prod.yaml too).
	request_body {
		max_size 10MB
	}

	# The health checks are for Docker and load balancers on the server, not for the
	# public: anyone could see when the database is down. (Inside a handle block: Caddy
	# runs handle blocks before a bare respond, so a bare one would never be reached.)
	@health path /healthz /readyz
	handle @health {
		respond 404
	}

	# Public uploads (the "public" storage), straight from the media_public volume. Must
	# match PUBLIC_MEDIA_URL in config/settings/files.py. No folder listings, and no
	# index.html served for a folder's address. Private uploads (/media/) are never
	# served from here: they go to the app, below.
	handle_path /media-public/* {
		root * /srv/media-public
		import download_headers
		file_server {
			index ""
		}
	}

	# Private uploads: the app checks who's asking (config/uploads.py) and, for someone
	# it allows, answers with the file's name in X-Accel-Redirect. Caddy then sends that
	# file from the media volume, so no Gunicorn worker streams it. Only the app can name
	# a file this way (visitors' requests can't set it), and only for /media/: must match
	# MEDIA_URL in config/settings/files.py.
	handle /media/* {
		log_skip
		reverse_proxy web:8000 {
			import app_proxy
			@private_upload header X-Accel-Redirect *
			handle_response @private_upload {
				# The app's cookies (e.g. a renewed session) and HTTPS-only header still
				# go with the file.
				copy_response_headers {
					include Set-Cookie Strict-Transport-Security
				}
				root * /srv/media
				rewrite * {rp.header.X-Accel-Redirect}
				import download_headers
				header Cache-Control "private, no-store"
				file_server {
					index ""
				}
			}
		}
	}

	handle {
		log_skip
		reverse_proxy web:8000 {
			import app_proxy
			# Any other page naming a file gets nothing sent: the header is dropped.
			header_down -X-Accel-Redirect
		}
	}

	# When the app doesn't answer (restarting, or down): the site's own page, with the
	# real status (502, 503 or 504), instead of an empty one. Error responses skip the
	# headers above, so they're added here too.
	handle_errors 502 503 504 {
		import security_headers
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			Cache-Control no-store
		}
		root * /srv/errors
		rewrite * /proxy_error.html
		file_server
	}
}
