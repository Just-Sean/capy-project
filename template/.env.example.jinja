# Every environment variable this project reads, with what it's for.
#
# Development: `cp .env.example .env`. The values below run the project on your
# machine with Postgres from `docker compose up -d db`. Never commit `.env`.
# Production: set these in the server's environment or the platform's secret store,
# not in a file in the repo. Lines starting with "#" show a variable's default.

# --- Environment ------------------------------------------------------------------

# development, test or production. Unset means production, the safest choice.
DJANGO_ENV=development
# Set to false to ignore this file (the production-settings tests do this).
# DJANGO_READ_DOT_ENV=true

# --- Core -------------------------------------------------------------------------

# Required in production: a long random string, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Development and tests use a built-in insecure key when this is unset.
# DJANGO_SECRET_KEY=
# Required in production: the domain names the site answers to, comma-separated,
# e.g. example.com,www.example.com. Development allows localhost.
# DJANGO_ALLOWED_HOSTS=
# Required in production: the admin's address, anything but admin/ and ending in
# a slash, e.g. staff-k3v9q2/. Development uses admin/.
# DJANGO_ADMIN_URL=
# Full origins (with https://) allowed to send forms, if they differ from the site's
# own, e.g. https://www.example.com. Usually empty.
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Debug pages with full error details. On in development, refused in production.
# DJANGO_DEBUG=true

# --- Database ---------------------------------------------------------------------

# Required everywhere. Development matches the Postgres from compose.yaml.
DATABASE_URL=postgres://app:app@localhost:5432/{{ project_slug }}
# Seconds each server process keeps its database connection open for reuse.
# DJANGO_CONN_MAX_AGE=60
# The port Postgres from compose.yaml listens on, on this machine.
# Change it if 5432 is already in use (and change DATABASE_URL to match).
# POSTGRES_PORT=5432

# --- HTTPS and security (production defaults are the secure ones) -------------------

# Redirect plain HTTP to HTTPS. Default: on in production, off elsewhere.
# DJANGO_SECURE_SSL_REDIRECT=false
# Send the login and form-protection cookies over HTTPS only. Same defaults.
# DJANGO_SESSION_COOKIE_SECURE=false
# DJANGO_CSRF_COOKIE_SECURE=false
# How long browsers must use HTTPS only for this domain (HSTS), in seconds.
# Default: one year (31536000) in production, 0 elsewhere. On a new domain start
# with 3600 and raise it once HTTPS works.
# DJANGO_SECURE_HSTS_SECONDS=0
# Apply HSTS to every subdomain too.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# true only behind a proxy you control (Caddy, nginx, a load balancer) that always
# sets X-Forwarded-Proto. Otherwise visitors could fake being on HTTPS.
# DJANGO_BEHIND_PROXY=false

# --- Logging ----------------------------------------------------------------------

# DEBUG, INFO, WARNING or ERROR.
# DJANGO_LOG_LEVEL=INFO

# --- Server (Gunicorn, in production) ---------------------------------------------

# Worker processes: about 2 x CPU cores + 1. Default 1.
# WEB_CONCURRENCY=1
