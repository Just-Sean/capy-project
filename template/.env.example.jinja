# Development settings. Copy to .env (git-ignored) and adjust:
#   cp .env.example .env
# Production never uses a file: the server sets real environment variables.

# Which environment this is: development, test or production.
#   development: runserver on your machine (debug on, plain HTTP, safe placeholders)
#   test:        set automatically by pytest; you never need to set it here
#   production:  the server; also what an unset DJANGO_ENV means
DJANGO_ENV=development

# The Postgres container from compose.yaml (user/password are dev-only).
DATABASE_URL=postgres://app:app@localhost:5432/{{ project_slug }}

# Optional: change if another project already uses port 5432 on your machine
# (then update DATABASE_URL to match).
# POSTGRES_PORT=5432

# --- Optional overrides ----------------------------------------------------------
# Development has built-in defaults for all of these; production requires the
# first three and refuses DJANGO_DEBUG=true.

# Any long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=change-me

# Comma-separated hostnames this site answers to.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Admin path. "admin/" is fine locally; production refuses it.
# DJANGO_ADMIN_URL=admin/

# Debug pages. On by default in development, never allowed in production.
# DJANGO_DEBUG=true
