# Every environment variable this project reads, with what it's for.
#
# Development: `cp .env.example .env`. The values below run the project on your
# machine with Postgres from `docker compose up -d db`. Never commit `.env`.
# Production: set these in the server's environment or the platform's secret store.
# With Docker Compose they go in .env.production, and the database login (user,
# password and database name) in .env.postgres: see the README's Production
# section. Never copy this file there, and don't put a .env file on a server: this
# one sets DJANGO_ENV=development, which turns debug on and HTTPS protections off.
#
# A commented-out variable (# NAME=value) shows its development value. Where other
# environments differ, the comment above it says so. A variable with nothing after
# "=" has no value to copy: fill one in before uncommenting it. Write each variable
# at the start of its line as NAME=value, with no spaces or quotes in the value and
# no comment after it.

# --- Environment ------------------------------------------------------------------

# development, test or production. Unset means production, the safest choice.
DJANGO_ENV=development

# --- Core -------------------------------------------------------------------------

# Required in production: a long random string, e.g. from
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# Development and tests use a built-in insecure key when this is unset.
# DJANGO_SECRET_KEY=
# Required in production: the domain names the site answers to, comma-separated,
# e.g. example.com,www.example.com. Development and tests allow localhost,
# 127.0.0.1, [::1] and testserver.
# DJANGO_ALLOWED_HOSTS=
# Required in production: the admin's address, anything but admin/, with no leading
# slash and ending in a slash, e.g. staff-k3v9q2/. Development and tests use admin/.
# DJANGO_ADMIN_URL=
# Other sites' full origins (with https://) allowed to send forms here,
# comma-separated, e.g. https://shop.example.com. Usually empty.
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Debug pages with full error details. Default: on in development, off in tests.
# Refused in production.
# DJANGO_DEBUG=true

# --- Database ---------------------------------------------------------------------

# Required everywhere. Development matches the Postgres from compose.override.yaml.
DATABASE_URL=postgres://app:app@localhost:5432/{{ project_slug }}
# Seconds each server process keeps its database connection open for reuse.
# DJANGO_CONN_MAX_AGE=60
# The port development's Postgres listens on, on this machine (docker compose
# reads it from .env). Change it if 5432 is already in use, and change DATABASE_URL
# to match.
# POSTGRES_PORT=5432

# --- Cache ------------------------------------------------------------------------

# Required everywhere except tests: Redis, for Django's cache, with its login. The
# value below is for development: the Redis that compose.override.yaml starts on
# this machine, user app, password app. Production with Docker Compose uses
# redis://app:PASSWORD@redis:6379/0, with the password from .env.redis. A Redis on
# another machine must use rediss:// (TLS).
CACHE_URL=redis://app:app@localhost:6379/0
# The port development's Redis listens on, on this machine (docker compose reads it
# from .env). Change it if 6379 is already in use, then change the port in
# CACHE_URL to match.
# REDIS_PORT=6379

# --- Email ------------------------------------------------------------------------

# How email is sent. Development prints it in the runserver terminal unless this is
# set; tests keep it in memory. Production may leave it out (sending then fails with
# an error), or set an encrypted mail server: smtp+tls://USER:PASSWORD@HOST:587
# (STARTTLS) or smtp+ssl://USER:PASSWORD@HOST:465. Percent-encode @ / : in the user
# or password (@ is %40). In development, smtp://localhost:1025 reaches a local
# mail catcher such as Mailpit.
# EMAIL_URL=consolemail://
# The From: address of every email. Required in production when EMAIL_URL is set,
# and usually on a domain you've verified with the mail service.
# DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost

# --- Uploaded files ---------------------------------------------------------------

# Where uploads are kept: filesystem (this machine's disk; in production the media
# Docker volume) or s3 (S3 or any S3-compatible service: R2, B2, MinIO, ...).
# Production doesn't serve local uploads yet (see the README's Uploaded files
# section): use s3 if a project needs uploads in production.
# DJANGO_MEDIA_STORAGE=filesystem
# With s3, required: the bucket. Files go under media/ in it, private, with signed
# links that expire after an hour, and download rather than open in the browser.
# DJANGO_MEDIA_S3_BUCKET=
# With s3: the bucket's region, e.g. eu-west-1. Set it on AWS; other services may
# not need one (R2 uses auto).
# DJANGO_MEDIA_S3_REGION=
# With s3 on a service other than AWS: its address. Must be https:// in production.
# DJANGO_MEDIA_S3_ENDPOINT_URL=
# With s3: an access key and its secret, for this bucket only (the README lists the
# permissions it needs). Leave both out to use the server's own role (e.g. an EC2
# or ECS role), which is safer than a long-lived key. They keep AWS's standard
# names (no DJANGO_ prefix) because boto3 reads them itself.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Login rate limiting ----------------------------------------------------------

# After this many failed logins for the same username from the same IP address,
# that pair is locked out.
# DJANGO_LOGIN_FAILURE_LIMIT=5
# After this many failed logins from one IP address, whatever usernames were tried,
# that address is locked out. Higher, so people sharing an address are fine.
# DJANGO_LOGIN_IP_FAILURE_LIMIT=30
# How long a lockout lasts, in minutes. Each further try during a lockout restarts
# the full time.
# DJANGO_LOGIN_LOCKOUT_MINUTES=15

# --- HTTPS and security (production defaults are the secure ones) -----------------

# Redirect plain HTTP to HTTPS. Default: on in production, off elsewhere.
# DJANGO_SECURE_SSL_REDIRECT=false
# Send the login and form-protection cookies over HTTPS only. Default: on in
# production, off elsewhere.
# DJANGO_SESSION_COOKIE_SECURE=false
# DJANGO_CSRF_COOKIE_SECURE=false
# How long browsers must use HTTPS only for this domain (HSTS), in seconds.
# Default: one year (31536000) in production, 0 elsewhere. On a new domain start
# with 3600 and raise it once HTTPS works.
# DJANGO_SECURE_HSTS_SECONDS=0
# Apply HSTS to every subdomain too. Default: true. Only takes effect when
# DJANGO_SECURE_HSTS_SECONDS is above 0. Set to false if any subdomain can't serve
# HTTPS.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Set to true when exactly one proxy you control (Caddy, nginx, a load balancer)
# sits in front of the app, handles HTTPS, sets X-Forwarded-Proto and adds the
# visitor's address as the last X-Forwarded-For entry (Caddy does both; nginx needs
# a proxy_set_header line for each). Without it, the HTTPS redirect loops forever
# and every visitor shares the proxy's address for login rate limiting. Never set it
# otherwise: visitors could fake being on HTTPS, or fake their address.
# DJANGO_BEHIND_PROXY=false

# --- Logging ----------------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
# DJANGO_LOG_LEVEL=INFO

# --- Only in the real environment (these do nothing in .env) ----------------------

# Set to false to skip loading .env. For example, this checks the settings the way
# a server with nothing set sees them (production), so expect it to report what's
# missing:
#   DJANGO_READ_DOT_ENV=false uv run python manage.py check
# The production-settings tests and the Docker build do this.
# DJANGO_READ_DOT_ENV=true
# Gunicorn's worker processes in production, about 2 x CPU cores + 1. Default 1.
# Set it in the server's environment, or in .env.production with Docker Compose.
# WEB_CONCURRENCY=1
