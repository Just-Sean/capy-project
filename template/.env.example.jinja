# Every environment variable this project reads, with what it's for.
#
# Development: `cp .env.example .env`. The values below run the project on your
# machine with Postgres from `docker compose up -d db`. Never commit `.env`.
# Production: set these in the server's environment or the platform's secret store.
# Don't put a .env file on a server: this one sets DJANGO_ENV=development, which
# turns debug on and the HTTPS protections off.
#
# A commented-out variable (# NAME=value) shows its development value. Where other
# environments differ, the comment above it says so. A variable with nothing after
# "=" has no value to copy: fill one in before uncommenting it. Write each variable
# at the start of its line, with no comment after the value.

# --- Environment ------------------------------------------------------------------

# development, test or production. Unset means production, the safest choice.
DJANGO_ENV=development

# --- Core -------------------------------------------------------------------------

# Required in production: a long random string, e.g. from
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# Development and tests use a built-in insecure key when this is unset.
# DJANGO_SECRET_KEY=
# Required in production: the domain names the site answers to, comma-separated,
# e.g. example.com,www.example.com. Development and tests allow localhost,
# 127.0.0.1, [::1] and testserver.
# DJANGO_ALLOWED_HOSTS=
# Required in production: the admin's address, anything but admin/, with no leading
# slash and ending in a slash, e.g. staff-k3v9q2/. Development and tests use admin/.
# DJANGO_ADMIN_URL=
# Other sites' full origins (with https://) allowed to send forms here,
# comma-separated, e.g. https://shop.example.com. Usually empty.
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Debug pages with full error details. Default: on in development, off in tests.
# Refused in production.
# DJANGO_DEBUG=true

# --- Database ---------------------------------------------------------------------

# Required everywhere. Development matches the Postgres from compose.yaml.
DATABASE_URL=postgres://app:app@localhost:5432/{{ project_slug }}
# Seconds each server process keeps its database connection open for reuse.
# DJANGO_CONN_MAX_AGE=60
# The port Postgres from compose.yaml listens on, on this machine (docker compose
# reads it from .env). Change it if 5432 is already in use, and change DATABASE_URL
# to match.
# POSTGRES_PORT=5432

# --- HTTPS and security (production defaults are the secure ones) -------------------

# Redirect plain HTTP to HTTPS. Default: on in production, off elsewhere.
# DJANGO_SECURE_SSL_REDIRECT=false
# Send the login and form-protection cookies over HTTPS only. Default: on in
# production, off elsewhere.
# DJANGO_SESSION_COOKIE_SECURE=false
# DJANGO_CSRF_COOKIE_SECURE=false
# How long browsers must use HTTPS only for this domain (HSTS), in seconds.
# Default: one year (31536000) in production, 0 elsewhere. On a new domain start
# with 3600 and raise it once HTTPS works.
# DJANGO_SECURE_HSTS_SECONDS=0
# Apply HSTS to every subdomain too. Default: true. Only takes effect when
# DJANGO_SECURE_HSTS_SECONDS is above 0. Set to false if any subdomain can't serve
# HTTPS.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Set to true when a proxy you control (Caddy, nginx, a load balancer) handles HTTPS
# and always sets X-Forwarded-Proto. Without it, the HTTPS redirect loops forever
# behind such a proxy. Never set it otherwise: visitors could fake being on HTTPS.
# DJANGO_BEHIND_PROXY=false

# --- Logging ----------------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
# DJANGO_LOG_LEVEL=INFO

# --- Only in the real environment (these do nothing in .env) ----------------------

# Set to false to skip loading .env, e.g.
#   DJANGO_READ_DOT_ENV=false uv run python manage.py check
# The production-settings tests and the Docker build do this.
# DJANGO_READ_DOT_ENV=true
# Gunicorn's worker processes in production, about 2 x CPU cores + 1. Default 1.
# Set it in the server's or container's environment (see the README).
# WEB_CONCURRENCY=1
