# Development settings. Copy to .env (git-ignored) and adjust:
#   cp .env.example .env
# Production never uses a file: the server sets these as real environment variables.

# Which environment this is:
#   development  your machine: debug on, plain HTTP, safe local defaults
#   test         set automatically by pytest; you never put it here
#   production   the default when unset: HTTPS-only, debug forbidden, required values
DJANGO_ENV=development

# The Postgres container from compose.yaml (user/password are dev-only).
DATABASE_URL=postgres://app:app@localhost:5432/{{ project_slug }}

# --- Optional overrides -----------------------------------------------------------
# Development already has sensible defaults for these; uncomment only to change them.
#
# Any long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=
#
# Comma-separated hostnames this site answers to.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#
# Admin path. "admin/" is fine locally; production refuses it.
# DJANGO_ADMIN_URL=admin/
#
# Debug pages (on by default in development). Production refuses true.
# DJANGO_DEBUG=true

# Optional: change if another project already uses port 5432 on your machine
# (then update DATABASE_URL to match).
# POSTGRES_PORT=5432
