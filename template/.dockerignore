# Keep the image small and never copy secrets into it.
.git
.venv
**/__pycache__
.pytest_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
# Every file whose name starts with .env, in any folder (no exceptions: the image
# doesn't need .env.example). Keep the **/ or Docker only matches the top folder.
**/.env*
staticfiles
media
tests
