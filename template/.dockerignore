# Keep the image small and never copy secrets into it.
.git
.venv
**/__pycache__
.pytest_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
# Every file whose name starts with .env, in any folder (no exceptions: the image
# doesn't need .env.example). Keep the **/ or Docker only matches the top folder.
**/.env*
# Private keys, certificates and keystores, and SSH keys, in any folder.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
staticfiles
media
media-public
# Backups (the README keeps them outside the project; this is in case one lands here):
# they hold the whole database and every upload.
**/*.dump
**/*.tar.gz
tests
