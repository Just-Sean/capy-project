{#- Named .jinja so git doesn't apply these rules to the starter's own template files
    (they would hide .env.example.jinja). New projects get it as plain .gitignore. -#}
# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Secrets: every file whose name starts with .env (.env, .env.local, .envrc, ...), in
# any folder, except the example. To commit another one, add a "!" line for it.
.env*
!.env.example
# Private keys, certificates and keystores, and SSH keys (which have no extension)
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Generated by Django
staticfiles/
media/
media-public/

# Backups: the whole database and every upload (the README keeps them outside the
# project; this is in case one lands here)
*.dump
*.tar.gz

# Editors / OS
.idea/
.vscode/
.DS_Store
